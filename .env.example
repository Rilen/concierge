# ==============================================================================
# CONCIERGE / OSTRAS.AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local in the root or specific workspace apps.
# Do NOT commit sensitive keys to version control.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DEPLOYMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_NAME="Concierge"
NEXT_PUBLIC_PLATFORM_TAGLINE="Seu assistente inteligente de gastronomia, reservas e conveniência"

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL / Neon / Supabase)
# ------------------------------------------------------------------------------
# Standard pooled connection string for serverless/app traffic
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/concierge_db?sslmode=require&pgbouncer=true"

# Direct connection string for Prisma migrations & CLI tasks
DIRECT_URL="postgresql://user:password@ep-sample.us-east-1.aws.neon.tech/concierge_db?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Better Auth / NextAuth)
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET="generate-a-secure-random-32-byte-hex-string-here"
BETTER_AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-hex-string-here"

# Admin / Master Seed Credentials (optional for initial onboarding)
ADMIN_DEFAULT_EMAIL="admin@concierge.ai"
ADMIN_DEFAULT_PASSWORD="ChangeMeInProduction123!"

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE & LLM PROVIDERS
# ------------------------------------------------------------------------------
# Google Gemini (Primary recommended for multimodal & large context)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_DEFAULT_MODEL="gemini-2.0-flash"

# OpenAI (Alternative provider & embeddings)
OPENAI_API_KEY="sk-proj-YourOpenAiApiKeyHere"
OPENAI_DEFAULT_MODEL="gpt-4o-mini"

# Anthropic Claude (Alternative provider for complex orchestration)
ANTHROPIC_API_KEY="sk-ant-YourAnthropicApiKeyHere"
ANTHROPIC_DEFAULT_MODEL="claude-3-5-sonnet-latest"

# AI Orchestration Defaults
AI_MAX_TOOL_STEPS=5
AI_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# 5. VECTOR SEARCH & RAG (Embeddings & Semantic Discovery)
# ------------------------------------------------------------------------------
# Upstash Vector or Pinecone for restaurant & menu semantic index
UPSTASH_VECTOR_REST_URL=""
UPSTASH_VECTOR_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 6. MESSAGING & WHATSAPP GATEWAY (Evolution API / Z-API / Twilio)
# ------------------------------------------------------------------------------
# Evolution API (Recommended open-source WhatsApp API)
EVOLUTION_API_URL="https://whatsapp.yourdomain.com"
EVOLUTION_API_KEY="your-evolution-global-or-instance-api-key"
EVOLUTION_INSTANCE_NAME="concierge-instance"
WHATSAPP_WEBHOOK_SECRET="whsec_concierge_secure_token"

# Optional Twilio fallback
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""

# ------------------------------------------------------------------------------
# 7. PAYMENTS & FINTECH (Mercado Pago / Stripe / Pix)
# ------------------------------------------------------------------------------
# Mercado Pago (Leading payment gateway for Pix & local cards in Brazil)
MERCADO_PAGO_ACCESS_TOKEN="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADO_PAGO_PUBLIC_KEY="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADO_PAGO_WEBHOOK_SECRET="your_mp_webhook_secret"

# Stripe (Global payments & card processing)
STRIPE_SECRET_KEY="sk_test_51..."
STRIPE_PUBLISHABLE_KEY="pk_test_51..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Pix Static / Manual Key fallback
PIX_KEY="financeiro@concierge.ai"
PIX_BENEFICIARY_NAME="Concierge Plataforma Digital LTDA"

# ------------------------------------------------------------------------------
# 8. CACHE, RATE LIMITING & QUEUES (Redis / Upstash)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 9. STORAGE & MEDIA ASSETS (Cloudinary / S3 / Uploadthing)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# ------------------------------------------------------------------------------
# 10. MARKETPLACE COMMISSION & GOVERNANCE RULES
# ------------------------------------------------------------------------------
# Default marketplace commission rate (e.g., 0.5% Paladar Golden Rule / Constitution Art. 40)
DEFAULT_PLATFORM_COMMISSION_PERCENT=0.5
MAX_ORDER_RETRIES=5
